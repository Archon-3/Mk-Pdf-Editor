# Google OAuth Web Client ID from Google Cloud Console
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Google AdSense (https://www.google.com/adsense/)
# Use your publisher ID like ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_CLIENT_ID=
# Ad unit slot IDs from AdSense → Ads → By ad unit
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_PRICING=
VITE_ADSENSE_SLOT_SUPPORT=

# Frontend public URL used in PayPal return/cancel links
FRONTEND_URL=http://localhost:5173

# Public site URL used for SEO canonical tags / sitemap (production domain)
VITE_SITE_URL=https://mkpdfeditor.com

# PayPal REST API (https://developer.paypal.com/dashboard/)
# Create a Sandbox app, then paste Client ID + Secret
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to 0 when real sandbox/live keys are configured (demo skip only when keys are missing)
PAYPAL_DEMO=0

# Optional: force PDF→Word engine (visual|libreoffice)
# PDF_TO_WORD_ENGINE=visual

# Developer unlimited mode
# Vite `npm run dev` already unlocks the frontend (badge: Dev).
# Set DEV_UNLIMITED=1 to unlock the backend for all local API calls too.
# Set VITE_FORCE_PLAN_LIMITS=true if you want to test Free/Pro gates locally.
# DEV_UNLIMITED=1
# VITE_DEV_UNLIMITED=true
# VITE_FORCE_PLAN_LIMITS=true

# Admin control center (/admin) — set a strong secret; never commit real passwords
ADMIN_PASSWORD=

# Firebase Authentication (Firebase Console → Project settings → Your apps → Web)
# Enable Email/Password + Google under Authentication → Sign-in method
# Add localhost to Authentication → Settings → Authorized domains
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Force login + Free/Pro limits even while developing (optional)
# VITE_FORCE_AUTH=true
# VITE_FORCE_PLAN_LIMITS=true
