# Google OAuth Web Client ID from Google Cloud Console
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Google AdSense (https://www.google.com/adsense/)
# Use your publisher ID like ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_CLIENT_ID=
# Ad unit slot IDs from AdSense → Ads → By ad unit
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_PRICING=
VITE_ADSENSE_SLOT_SUPPORT=
